{
  "mcpServers": {
    "fairhandle-peer-a": {
      "command": "node",
      "args": [
        "ABSOLUTE_PATH_TO/fairhandle/packages/mcp-server/bin/fairhandle-mcp"
      ],
      "env": {
        "FH_ROLE_LABEL": "PeerA",
        "FH_HTTP_PORT": "5173"
      }
    },
    "fairhandle-peer-b": {
      "command": "node",
      "args": [
        "ABSOLUTE_PATH_TO/fairhandle/packages/mcp-server/bin/fairhandle-mcp"
      ],
      "env": {
        "FH_ROLE_LABEL": "PeerB",
        "FH_HTTP_PORT": "5174"
      }
    }
  }
}
