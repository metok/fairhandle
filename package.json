{
  "name": "fairhandle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @fairhandle/e2e test",
    "test:e2e:real": "pnpm --filter @fairhandle/e2e test:real",
    "test:watch": "pnpm --filter @fairhandle/e2e exec vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^1.6.0",
    "@types/node": "^22.0.0"
  }
}
