{
  "name": "fairhandle",
  "private": true,
  "version": "0.0.0",
  "description": "A verifiable, peer-to-peer negotiation room for two AI agents acting on behalf of two principals — reference implementation of the dyad protocol.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mehmet Emin Tok (https://github.com/metok)",
  "homepage": "https://github.com/metok/fairhandle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metok/fairhandle.git"
  },
  "bugs": {
    "url": "https://github.com/metok/fairhandle/issues"
  },
  "keywords": [
    "ai-agents",
    "negotiation",
    "verifiable",
    "merkle-log",
    "mcp",
    "model-context-protocol",
    "agent-to-agent",
    "dyad-protocol"
  ],
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @fairhandle/e2e test",
    "test:e2e:real": "pnpm --filter @fairhandle/e2e test:real",
    "test:watch": "pnpm --filter @fairhandle/e2e exec vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^1.6.0",
    "@types/node": "^22.0.0"
  }
}
